{
  "name": "@thanhpp/pi-context",
  "version": "0.1.0",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/thanhpp/pi-context.git" },
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "keywords": ["pi-package"],
  "files": ["src", "skills", "vendor", "README.md", "LICENSE", "docs/verification.md"],
  "pi": {
    "extensions": ["./src/extension.ts"],
    "skills": ["./skills/pi-context"]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "demo": "node --experimental-strip-types scripts/two-session-demo.ts",
    "eval:recall": "node --experimental-strip-types scripts/eval-recall.ts",
    "eval:inspect": "node --experimental-strip-types scripts/inspect-recall.ts"
  },
  "dependencies": { "proper-lockfile": "4.1.2" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
